{
  "name": "bank-api",
  "version": "1.0.0",
  "description": "API for bank accounts and Pix transactions",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "compile:proto": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/proto --ts_proto_opt=outputServices=grpc-js,forceLong=long --proto_path=./proto ./proto/pix.proto"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.2",
    "@nestjs/common": "^10.2.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.2.5",
    "@nestjs/microservices": "^9.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/typeorm": "^9.0.0",
    "kafkajs": "^2.2.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0",
    "sqlite3": "^5.0.0",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@types/node": "^16.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.0.0",
    "eslint-plugin-prettier": "^4.0.0",
    "prettier": "^2.0.0",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.0.0",
    "ts-proto": "^2.7.0",
    "tsconfig-paths": "^3.0.0",
    "typescript": "^4.0.0"
  }
}
